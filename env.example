# =============================================================
# AI Medical Diagnosis Assistant — Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to git. This file (.env.example) is safe to commit.
# =============================================================


# ── OpenAI ────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Models used per agent (change only if you want to swap models)
SYNTHESIS_MODEL=gpt-4o
TRIAGE_MODEL=gpt-4o-mini
DRUG_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1536


# ── Pinecone ──────────────────────────────────────────────────
# Get your key at: https://app.pinecone.io → API Keys
PINECONE_API_KEY=
PINECONE_INDEX_NAME=medical-knowledge-base
PINECONE_ENVIRONMENT=us-east-1


# ── LangSmith (tracing & evaluation) ─────────────────────────
# Get your key at: https://smith.langchain.com → Settings → API Keys
# Create a project named "medical-diagnosis-assistant" in LangSmith first
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=medical-diagnosis-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com


# ── Cohere (re-ranking) ───────────────────────────────────────
# Get your key at: https://dashboard.cohere.com → API Keys
COHERE_API_KEY=


# ── OpenFDA (drug interaction data) ──────────────────────────
# Get your key at: https://open.fda.gov/apis/authentication
# Free tier: 1,000 requests/hour
OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov/drug


# ── RAG parameters ────────────────────────────────────────────
# Adjust these only if you need to tune retrieval performance
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_K=10
RERANK_TOP_N=5
BM25_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6


# ── Agent behavior ────────────────────────────────────────────
MAX_RETRIES=3
REQUEST_TIMEOUT=30
PIPELINE_TIMEOUT=120


# ── Streamlit ─────────────────────────────────────────────────
# Optional: set a custom port if 8501 is taken
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
